+/**
+ * L1: the engine is an unmodified goose release, so the product identity is
+ * appended to the system prompt under its own key on every session the desktop
+ * creates or loads. Failure is non-fatal; the session still works as goose.
+ */
+async function applyBrandIdentity(
+  client: Awaited<ReturnType<typeof getAcpClient>>,
+  sessionId: string
+): Promise<void> {
+  try {
+    await client.goose.sessionSystemPromptSet_unstable({
+      sessionId,
+      mode: 'append',
+      key: 'brand-identity',
+      text: BRAND.identity,
+    });
+  } catch (error) {
+    console.warn('[brand] could not apply identity prompt', error);
+  }
